# Required
TELEGRAM_BOT_TOKEN=your_bot_token
WEBHOOK_PREFIX=https://your-domain.com/tgbot

# Default model for new users
DEFAULT_MODEL=openai/gpt-4o-mini

# Database configuration
# Option 1: PostgreSQL (production) - set all these:
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=bot
# DB_PASSWORD=secret
# DB_NAME=bot
# DB_SSLMODE=require

# Option 2: SQLite (development) - if DB_HOST not set, uses SQLite
# DATABASE_URL=sqlite:///./bot.db  # optional, defaults to bot.db
